# ============================================
# 小说投稿平台 环境变量配置
# 复制此文件为 .env.local 并填入真实值
# 这些值从 Supabase 控制台获取（详见部署文档）
# ============================================

# Supabase 项目 URL（形如 https://xxxx.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=

# Supabase 可发布密钥（Publishable key，可公开，用于浏览器端）
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
